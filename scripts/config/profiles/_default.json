  "api_detection": {
    "public_prefixes": [],
    "internal_patterns": [
      "_unit_",
      "_ut_",
      "_test_",
      "_perf_",
      "_verify_",
      "_example_",
      "_internal",
      "_priv",
      "_stub",
      "_mock"
    ],
    "public_header_paths": [],
    "export_macros": [],
    "struct_op_types": [],
    "auto_detect": false
  },
  "callback_detection": {
    "static_patterns": [
      {
        "register_func": "pthread_create",
        "regex": "pthread_create\\s*\\(\\s*[^,]*,\\s*[^,]*,\\s*(\\w+)",
        "cb_arg_index": 2,
        "concurrency_type": "spawn_target"
      }
    ],
    "generic_cb_suffixes": [
      "_cb",
      "_fn",
      "_handler",
      "_callback"
    ],
    "skip_call_prefixes": []
  },
  "endpoint_classification": {
    "lib_prefix_map": {
      "pthread_": "external_posix",
      "sem_": "external_posix",
      "epoll_": "external_posix"
    }
  },
  "macro_heuristics": {
    "macro_condition_prefixes": [
      "HAVE_",
      "ENABLE_",
      "WITH_",
      "USE_"
    ]
  },
  "scan_hints": {
    "pre_scan_dirs": [
      "doc",
      "examples",
      "app"
    ],
    "test_dirs": [
      "test",
      "ut"
    ],
    "header_priority_dirs": [
      "include"
    ],
    "vtable_module_keys": [],
    "domain_rules": []
  },
  "macro_dispatch": {
    "registration_macros": [],
    "token_paste_macros": [],
    "macro_aliases": {}
  },
  "struct_embeddings": {
    "container_of_macros": [],
    "manual_entries": []
  },
  "project_boundaries": {
    "non_api_paths": [],
    "test_path_patterns": ["/test/", "/tests/", "/unit/", "/ut/",
                           "/unittest/", "/fuzz/", "\\test\\",
                           "\\tests\\", "\\unit\\"],
    "test_file_suffixes": ["_test.c", "_test.cpp", "_ut.c", "_ut.cpp",
                           "_unittest.c", "_unittest.cpp",
                           "test_.c", "test_.cpp"],
    "test_domain_segments": ["ut", "ut_mock", "unit", "test", "fuzz"],
    "vendor_domain_prefixes": [],
    "external_dir_prefixes": ["vendor", "third_party", "thirdparty",
                              "external", "3rdparty", "contrib"]
  },
  "concurrency_patterns": {
    "lock_acquire_patterns": [],
    "lock_release_patterns": []
  },
  "io_classification": {
    "io_main_keywords": [],
    "io_side_keywords": []
  },
  "phases": {
    "prescan_completed": false,
    "test_scan_completed": false,
    "llm_header_analysis_completed": false,
    "llm_result_check_completed": false
