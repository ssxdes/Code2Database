{
  "version": 1,
  "project": {
    "name": "asm_project",
    "language": "asm",
    "detected_frameworks": []
  },
  "skip_names": {
    "add": [
      "syscall", "sys_read", "sys_write", "sys_exit",
      "sys_open", "sys_close", "sys_mmap", "sys_munmap",
      "sys_ioctl", "sys_fork", "sys_execve", "sys_wait4",
      "printf", "strtod", "write", "exit", "malloc", "free"
    ],
    "external_lib_prefixes": {},
    "test_framework_prefixes": []
