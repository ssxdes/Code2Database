    "macro_condition_prefixes": []
  },
  "macro_dispatch": {
    "registration_macros": [],
    "token_paste_macros": [],
    "macro_aliases": {}
  },
  "struct_embeddings": {
    "container_of_macros": [],
    "manual_entries": []
  },
  "threading_models": {},
  "scan_hints": {
    "pre_scan_dirs": [],
    "test_dirs": [],
    "header_priority_dirs": [],
    "vtable_module_keys": [],
    "domain_rules": []
  },
  "phases": {
    "scan_complete": false,
    "build_complete": false,
    "validated": false
  }
