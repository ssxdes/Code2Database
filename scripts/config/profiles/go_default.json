{
  "version": 1,
  "project": {
    "name": "go_default",
    "language": "go",
    "detected_frameworks": []
  },
  "skip_names": {
    "add": [
      "append",
      "cap",
      "close",
      "complex",
      "copy",
      "delete",
      "imag",
      "len",
      "make",
      "new",
      "panic",
      "print",
      "println",
      "real",
      "recover",
      "error",
      "bool",
      "string",
      "int",
      "int8",
      "int16",
      "int32",
      "int64",
      "uint",
      "uint8",
      "uint16",
      "uint32",
      "uint64",
      "uintptr",
      "float32",
      "float64",
      "complex64",
      "complex128",
      "byte",
      "rune",
      "true",
      "false",
      "nil",
      "iota",
      "break",
      "case",
      "chan",
      "const",
      "continue",
      "default",
      "defer",
      "else",
      "fallthrough",
      "for",
      "func",
      "go",
      "goto",
      "if",
      "import",
      "interface",
      "map",
      "package",
      "range",
      "return",
      "select",
      "struct",
      "switch",
      "type",
      "var"
    ],
    "external_lib_prefixes": {
      "fmt.": {"category": "external_stdlib", "visible": false},
      "os.": {"category": "external_stdlib", "visible": false},
      "io.": {"category": "external_stdlib", "visible": false},
      "strings.": {"category": "external_stdlib", "visible": false},
      "strconv.": {"category": "external_stdlib", "visible": false},
      "bytes.": {"category": "external_stdlib", "visible": false},
      "errors.": {"category": "external_stdlib", "visible": false},
      "time.": {"category": "external_stdlib", "visible": false},
      "sync.": {"category": "external_stdlib", "visible": false},
      "math.": {"category": "external_stdlib", "visible": false},
      "sort.": {"category": "external_stdlib", "visible": false},
      "encoding/json.": {"category": "external_stdlib", "visible": false},
      "net/http.": {"category": "external_stdlib", "visible": false},
      "context.": {"category": "external_stdlib", "visible": false}
    },
    "test_framework_prefixes": ["Test", "Benchmark", "Example", "Fuzz"]
  },
  "api_detection": {
    "public_prefixes": [],
    "internal_patterns": ["_test", "_internal", "_priv"],
    "public_header_paths": [],
    "export_macros": [],
    "struct_op_types": [],
    "auto_detect": false
  },
  "callback_detection": {
    "static_patterns": [],
    "generic_cb_suffixes": ["Func", "Callback", "Handler", "Cb", "Fn"],
    "skip_call_prefixes": []
  },
  "endpoint_classification": {
    "lib_prefix_map": {}
  },
  "macro_heuristics": {
    "macro_condition_prefixes": []
  },
  "scan_hints": {
    "pre_scan_dirs": ["cmd", "examples", "demo"],
    "test_dirs": ["test", "_test"],
    "header_priority_dirs": [],
    "vtable_module_keys": [],
    "domain_rules": [],
    "skip_dirs": ["vendor", "node_modules", ".git", "dist", "build"]
  },
  "macro_dispatch": {
    "registration_macros": [],
    "token_paste_macros": [],
    "macro_aliases": {}
  },
  "struct_embeddings": {
    "container_of_macros": [],
    "manual_entries": []
  },
  "dispatch_tuning": {
    "max_vtable_dispatch_per_call": 50,
    "max_vtable_dispatch_per_field": {},
    "inline_wrapper_patterns": [],
    "macro_bridge_patterns": [],
    "macro_bridge_require_same_domain": false,
    "fn_ptr_call_require_evidence": false
  },
  "phases": {
    "prescan_completed": false,
    "test_scan_completed": false,
    "llm_header_analysis_completed": false,
    "llm_result_check_completed": false
  }
}
