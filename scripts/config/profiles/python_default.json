{
  "version": 1,
  "project": {
    "name": "python_default",
    "language": "python",
    "detected_frameworks": []
  },
  "skip_names": {
    "add": [
      "False",
      "None",
      "True",
      "and",
      "as",
      "assert",
      "async",
      "await",
      "break",
      "class",
      "continue",
      "def",
      "del",
      "elif",
      "else",
      "except",
      "finally",
      "for",
      "from",
      "global",
      "if",
      "import",
      "in",
      "is",
      "lambda",
      "nonlocal",
      "not",
      "or",
      "pass",
      "raise",
      "return",
      "try",
      "while",
      "with",
      "yield",
      "print",
      "len",
      "range",
      "str",
      "int",
      "float",
      "bool",
      "list",
      "dict",
      "set",
      "tuple",
      "type",
      "isinstance",
      "issubclass",
      "getattr",
      "setattr",
      "hasattr",
      "delattr",
      "super",
      "property",
      "staticmethod",
      "classmethod",
      "abs",
      "min",
      "max",
      "sum",
      "sorted",
      "reversed",
      "enumerate",
      "zip",
      "map",
      "filter",
      "any",
      "all",
      "open",
      "repr",
      "format",
      "id",
      "hash",
      "iter",
      "next"
    ],
    "external_lib_prefixes": {
      "os.": {"category": "external_stdlib", "visible": false},
      "sys.": {"category": "external_stdlib", "visible": false},
      "json.": {"category": "external_stdlib", "visible": false},
      "re.": {"category": "external_stdlib", "visible": false},
      "time.": {"category": "external_stdlib", "visible": false},
      "datetime.": {"category": "external_stdlib", "visible": false},
      "logging.": {"category": "external_stdlib", "visible": false},
      "collections.": {"category": "external_stdlib", "visible": false},
      "itertools.": {"category": "external_stdlib", "visible": false},
      "functools.": {"category": "external_stdlib", "visible": false},
      "pathlib.": {"category": "external_stdlib", "visible": false},
      "asyncio.": {"category": "external_stdlib", "visible": false},
      "threading.": {"category": "external_stdlib", "visible": false}
    },
    "test_framework_prefixes": ["test_", "Test", "_test"]
  },
  "api_detection": {
    "public_prefixes": [],
    "internal_patterns": ["_test", "_internal", "_priv", "__"],
    "public_header_paths": [],
    "export_macros": [],
    "struct_op_types": [],
    "auto_detect": false
  },
  "callback_detection": {
    "static_patterns": [],
    "generic_cb_suffixes": ["_cb", "_callback", "_handler", "_fn", "callback", "handler"],
    "skip_call_prefixes": []
  },
  "endpoint_classification": {
    "lib_prefix_map": {}
  },
  "macro_heuristics": {
    "macro_condition_prefixes": []
  },
  "scan_hints": {
    "pre_scan_dirs": ["examples", "demo", "docs"],
    "test_dirs": ["test", "tests", "_test"],
    "header_priority_dirs": [],
    "vtable_module_keys": [],
    "domain_rules": [],
    "skip_dirs": ["__pycache__", ".venv", "venv", "env", ".git", "node_modules", ".tox", ".mypy_cache", ".pytest_cache"]
  },
  "macro_dispatch": {
    "registration_macros": [],
    "token_paste_macros": [],
    "macro_aliases": {}
  },
  "struct_embeddings": {
    "container_of_macros": [],
    "manual_entries": []
  },
  "dispatch_tuning": {
    "max_vtable_dispatch_per_call": 50,
    "max_vtable_dispatch_per_field": {},
    "inline_wrapper_patterns": [],
    "macro_bridge_patterns": [],
    "macro_bridge_require_same_domain": false,
    "fn_ptr_call_require_evidence": false
  },
  "phases": {
    "prescan_completed": false,
    "test_scan_completed": false,
    "llm_header_analysis_completed": false,
    "llm_result_check_completed": false
  }
}
